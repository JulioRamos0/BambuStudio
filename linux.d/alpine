    openssl-dev
    openvdb-dev
    pkgconf
    texinfo
    unzip
    wget
    wxwidgets-dev
    wxwidgets-gtk3
    x264-dev
    yasm
)

if [[ -n "$UPDATE_LIB" ]]
then
    REQUIRED_DEV_PACKAGES+=(webkit2gtk-4.1-dev)
    if [[ -n "$BUILD_DEBUG" ]]
    then
        REQUIRED_DEV_PACKAGES+=(openssl-dev curl-dev)
    fi

    # Update and install packages
    # Use sudo if available and not root, otherwise just apk
    if [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1; then
        sudo apk update
        sudo apk add --no-cache ${REQUIRED_DEV_PACKAGES[@]} || true
    else
        apk update
        apk add --no-cache ${REQUIRED_DEV_PACKAGES[@]} || true
    fi

    echo -e "done\n"
    exit 0
fi

FOUND_GTK3_DEV=$(apk info -e gtk+3.0-dev || echo '')
