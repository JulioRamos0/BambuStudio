REQUIRED_DEV_PACKAGES=(
    assimp-dev
    autoconf
    bash
    boost-dev
    build-base
    bzip2-dev
    cereal
    cgal-dev
    cmake
    coreutils
    curl-dev
    dbus-dev
    eigen-dev
    eudev-dev
    extra-cmake-modules
    ffmpeg-dev
    ffmpeg-libs
    file
    fuse-dev
    gcompat
    gettext
    git
    glew-dev
    glfw-dev
    glu-dev
    gmp-dev
    gst-plugins-base-dev
    gstreamer-dev
    gtk+3.0-dev
    libgcc
    libmspack-dev
    libsecret-dev
    libstdc++
    libtool
    libunwind-dev
    libxkbcommon-dev
    make
    mesa-dev
    mesa-gbm
    mesa-gles
    mpfr-dev
    nasm
    ninja
    nlopt-dev
